# Configuración del grupo para el mail real con Brevo (se sube al repositorio a pedido del grupo).

# Usuarios registrados de la sesión simulada (FAQ 19), separados por coma.
# Agregá tu mail para recibir la confirmación de verdad.
USUARIOS_REGISTRADOS=visitante@mail.com,otro@mail.com,icsg014k3@gmail.com,marinmarcosjavier@gmail.com

# SMTP de Brevo: en Brevo, "SMTP & API" > pestaña "SMTP".
# SMTP_USUARIO es el "Login" que muestra Brevo (algo como 1a2b3c@smtp-brevo.com),
# y SMTP_CLAVE es una "SMTP key" que se genera ahí mismo (no es la contraseña de la cuenta).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=bf0be0001@smtp-brevo.com
SMTP_CLAVE=xsmtpsib-416dff96e01c397c811b47fd36f50490fbfa4144682a908a68ff69a735823043-kl8lvW2CFiXsGaTJ

# Remitente: tiene que ser un remitente verificado en Brevo ("Senders, Domains & Dedicated IPs").
MAIL_REMITENTE="EcoHarmony Park <icsg014k3@gmail.com>"
