{
  "name": "comprar-entradas",
  "version": "1.0.0",
  "description": "TP 6 - TDD: User Story Comprar entradas (EcoHarmony Park)",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Reporte de pruebas - Comprar entradas",
          "outputPath": "reportes/reporte-pruebas.html",
          "includeFailureMsg": true,
          "dateFormat": "dd/mm/yyyy HH:MM:ss",
          "sort": "default"
        }
      ]
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
